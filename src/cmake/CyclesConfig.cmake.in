# Cycles CMake package.
#
# Provides the imported target `Cycles::cycles`, an interface that carries the
# include directories and compile definitions required to compile against the
# Cycles headers, and links the combined `libcycles` shared library.

@PACKAGE_INIT@

set(Cycles_VERSION "@CYCLES_VERSION_STRING@")

@CYCLES_INCLUDE_DIRS_CODE@

@CYCLES_COMPILE_DEFINITIONS_CODE@

get_filename_component(Cycles_LIBRARY_DIR "${CMAKE_CURRENT_LIST_DIR}/../../" ABSOLUTE)
get_filename_component(Cycles_PREFIX_DIR "${Cycles_LIBRARY_DIR}/.." ABSOLUTE)
set(Cycles_SHADER_DIR "${Cycles_PREFIX_DIR}/shader")

@CYCLES_DEPENDENCY_LIBRARIES_CODE@

if(NOT TARGET Cycles::cycles)
  add_library(Cycles::cycles SHARED IMPORTED)
  set_target_properties(Cycles::cycles PROPERTIES
    IMPORTED_LOCATION "${Cycles_LIBRARY_DIR}/@CMAKE_SHARED_LIBRARY_PREFIX@cycles@CMAKE_SHARED_LIBRARY_SUFFIX@"
    INTERFACE_INCLUDE_DIRECTORIES "${Cycles_INCLUDE_DIRS}"
    INTERFACE_COMPILE_DEFINITIONS "${Cycles_COMPILE_DEFINITIONS}"
    INTERFACE_LINK_LIBRARIES "${Cycles_DEPENDENCY_LIBRARIES}"
    INTERFACE_COMPILE_FEATURES "cxx_std_20"
  )
  if(WIN32)
    set_target_properties(Cycles::cycles PROPERTIES
      IMPORTED_IMPLIB "${Cycles_LIBRARY_DIR}/@CMAKE_STATIC_LIBRARY_PREFIX@cycles@CMAKE_STATIC_LIBRARY_SUFFIX@")
  endif()
endif()

set(Cycles_LIBRARIES Cycles::cycles)

check_required_components(Cycles)
